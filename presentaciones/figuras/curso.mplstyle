# Paleta Okabe–Ito de plantillas/template.typ: azul, naranja, verde y violeta.
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7'])

figure.figsize: 6, 4
figure.constrained_layout.use: True
savefig.format: pdf
# Type 3 preserva los contornos de Fira Math (OpenType/CFF) al incrustarlos.
pdf.fonttype: 3

font.family: Atkinson Hyperlegible
font.size: 12
text.color: 343a40
axes.labelcolor: 343a40
axes.edgecolor: 343a40
xtick.color: 343a40
ytick.color: 343a40

# Las fórmulas usan la misma familia que en la presentación.
mathtext.fontset: custom
mathtext.rm: Fira Math
mathtext.it: Fira Math:style=italic
mathtext.bf: Fira Math
mathtext.bfit: Fira Math:style=italic
mathtext.cal: Fira Math
mathtext.sf: Fira Math
mathtext.tt: Fira Math
mathtext.fallback: None

axes.spines.left: True
axes.spines.bottom: True
axes.spines.right: False
axes.spines.top: False
xtick.top: False
xtick.bottom: True
xtick.direction: out
ytick.left: True
ytick.right: False
ytick.direction: out
